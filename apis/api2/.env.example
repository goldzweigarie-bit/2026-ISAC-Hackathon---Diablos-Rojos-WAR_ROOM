# Configuración del API 2. Copia este archivo a .env y llena las llaves:
#     cp .env.example .env
# Genera cada llave con:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# El archivo .env NUNCA va a GitHub.

# Llave de LECTURA: la usan el traductor de la web app y quien solo consulta resultados.
API_KEY=

# Llave de ESCRITURA: solo los notebooks de los modelos (suben y borran tablas). Distinta a la de lectura.
API_KEY_ESCRITURA=

# Dónde se guardan las tablas, FUERA del repo (el repo es público).
DATOS_DIR=~/Desktop/hackathon
RESULTADOS_DIR=~/Desktop/hackathon/resultados_api2
