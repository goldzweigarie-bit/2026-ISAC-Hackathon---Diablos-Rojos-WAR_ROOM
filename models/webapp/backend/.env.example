# Configuración del traductor. Copia este archivo a .env y llena las llaves:
#     cp .env.example .env
# El archivo .env NUNCA va a GitHub (ya está en .gitignore).

# API 1: datos (pitcheos). La misma llave que está en api/.env
API1_URL=http://localhost:8000
API1_KEY=

# API 2: resultados de los modelos. Usa la llave de LECTURA (API_KEY de api2/.env), no la de escritura.
API2_URL=http://localhost:8001
API2_KEY=

# Opcional: link al paper para la página de Metodología
# PAPER_URL=
